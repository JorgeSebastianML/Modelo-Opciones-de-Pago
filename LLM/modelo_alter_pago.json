      "parameters": {
        "jsCode": "const texto = $json.output;\n\nconst resultado = {};\n\ntexto\n  .split('##')\n  .map(x => x.trim())\n  .filter(x => x)\n  .forEach(parte => {\n    const [clave, ...valor] = parte.split(':');\n    resultado[clave.trim()] = valor.join(':').trim();\n  });\n\nreturn [{ json: resultado }];"
